# Google OAuth (前往 https://console.cloud.google.com/ 建立 OAuth 2.0 憑證)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Sheets (試算表的 ID，從網址列取得)
GOOGLE_SHEETS_ID=

# Gemini AI (前往 https://aistudio.google.com/ 取得 API 金鑰)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (前往 https://supabase.com/ 建立專案後取得)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
