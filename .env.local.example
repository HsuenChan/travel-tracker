# Gemini AI (前往 https://aistudio.google.com/ 取得 API 金鑰)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets 匯出（Google Cloud Console 的 OAuth 2.0 Web 用戶端 ID，可沿用 Supabase 那顆）
# 需啟用 Google Sheets API，並把本機與正式網址加進「已授權的 JavaScript 來源」
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase (前往 https://supabase.com/ 建立專案後取得)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Bot (前往 https://developers.line.biz/ 建立 Messaging API channel)
LINE_BOT_USER_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 你的 App 公開網址（用於 Flex Message 的 detail 連結）
NEXT_PUBLIC_APP_URL=https://your-domain.com
# LINE Bot 加好友的連結（從 LINE Developers 取得）
NEXT_PUBLIC_LINE_BOT_URL=https://line.me/R/ti/p/@your-bot-id
